//IO输出
M7700->Y:$78402,8,1 ; SEL0输出//J8复用端口数字输入输出
M7701->Y:$78402,9,1 ; SEL1输出
M7702->Y:$78402,10,1 ; SEL2输出
M7703->Y:$78402,11,1 ; SEL3输出
M7704->Y:$78402,12,1 ; SEL4输出
M7705->Y:$78402,13,1 ; SEL5输出
M7706->Y:$78402,14,1 ; SEL6输出
M7707->Y:$78402,15,1 ; SEL7输出

M7708->Y:$78400,0 ; 数字输出MO1//JOPT通用I/O端口
M7709->Y:$78400,1 ; 数字输出MO2
M7710->Y:$78400,2 ; 数字输出MO3
M7711->Y:$78400,3 ; 数字输出MO4
M7712->Y:$78400,4 ; 数字输出MO5
M7713->Y:$78400,5 ; 数字输出MO6
M7714->Y:$78400,6 ; 数字输出MO7
M7715->Y:$78400,7 ; 数字输出MO8



//IO输入


M7900->Y:$78402,0,1 ; DAT0 输入//J8复用端口数字输入输出
M7901->Y:$78402,1,1 ; DAT1输入
M7902->Y:$78402,2,1 ; DAT2输入
M7903->Y:$78402,3,1 ; DAT3输入
M7904->Y:$78402,4,1 ; DAT4输入
M7905->Y:$78402,5,1 ; DAT5输入
M7906->Y:$78402,6,1 ; DAT6输入
M7907->Y:$78402,7,1 ; DAT7输入
M7908->Y:$78400,8 ; 数字输入MI1//JOPT通用I/O端口
M7909->Y:$78400,9 ; 数字输入MI2
M7910->Y:$78400,10 ; 数字输入MI3
M7911->Y:$78400,11 ; 数字输入MI4
M7912->Y:$78400,12 ; 数字输入MI5
M7913->Y:$78400,13 ; 数字输入MI6
M7914->Y:$78400,14 ; 数字输入MI7
M7915->Y:$78400,15 ; 数字输入MI8

//控制位
M7820->X:$78400,0,8 ; 方向控制位0-7 (1为输出, 0为输入)
M7821->X:$78400,8,8 ; 方向控制位8-15 (1输出, 0为输入)
M7822->X:$78404,0,24 ; 反向控制(0 = 0V, 1 = 5V)
M7823->Y:$78404,0,24 ; J9端口数据类型 (1 = I/O)

//输出字控制
M7718->Y:$78402,8,8,U ; SEL0-7作为输出字使用
M7719->Y:$78400,0,8,U ; 数字输出MO输出字

//输入字控制
M7918->Y:$78402,0,8,U ; DAT0-7作为输入字使用
M7919->Y:$78400,8,8,U ; 数字输入MI1


//配置
M7820=$FF ; 0-8位定义为输出
M7821=$0 ; 9-16位定义为输入
M7822=$FF00 ; 定义输入输出
M7823=$FFFF ; 所有点均为I/O类型

//配置
OPEN PLC1 CLEAR
M7820=$FF ; 0-8位定义为输出
M7821=$0 ; 9-16位定义为输入
M7822=$FF00 ; 定义输入输出
M7823=$FFFF ; 所有点均为I/O类型
DIS PLC1 ; 禁用（在上电时扫描一次并立即禁用)
CLOSE

