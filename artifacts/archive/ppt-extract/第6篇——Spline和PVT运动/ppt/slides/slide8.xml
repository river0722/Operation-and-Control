间</a:t></a:r><a:r><a:rPr lang="en-US" altLang="zh-CN" dirty="0"/><a:t>200ms</a:t></a:r></a:p><a:p><a:r><a:rPr lang="en-US" altLang="zh-CN" dirty="0"/><a:t>	X 10:5  //X</a:t></a:r><a:r><a:rPr lang="zh-CN" altLang="en-US" dirty="0"/><a:t>轴运动距离</a:t></a:r><a:r><a:rPr lang="en-US" altLang="zh-CN" dirty="0"/><a:t>10mm </a:t></a:r><a:r><a:rPr lang="zh-CN" altLang="en-US" dirty="0"/><a:t>结束速度为</a:t></a:r><a:r><a:rPr lang="en-US" altLang="zh-CN" dirty="0"/><a:t>5</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="4176824612"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>